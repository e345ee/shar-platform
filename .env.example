APP_CORS_ALLOWED_ORIGINS=http://localhost:${FRONTEND_PORT},http://127.0.0.1:${FRONTEND_PORT}


REACT_APP_API_URL=http://localhost:${BACKEND_PORT}


SPRING_MAIL_HOST=smtp.gmail.com
